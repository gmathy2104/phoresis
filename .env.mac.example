# Phoresis on a Mac (scripts/mac/phoresis.sh, docs/INSTALL-MAC.md).
# `install` asks for the accounts and generates every secret: you only need this file to install
# without questions (--yes) or to change a default. Copy to .env, keep it private (chmod 600).

# Accounts created at first start
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
PRIMARY_USER_EMAIL=lab@example.com
PRIMARY_USER_PASSWORD=change-me
PRIMARY_USER_FULL_NAME=Lab User

# --- everything below is optional: shown with its default ---

# Address. 443 when nothing else uses it, else 8443 (CamHub holds 443 on the shared Mac).
#PHORESIS_HOSTNAME=phoresis.local
#PHORESIS_HTTPS_PORT=8443
# Set by `phoresis.sh shared-caddy use DIR`: no Caddy of our own, the site is a file in that folder,
# read by the Caddy of the app that holds port 443 (CamHub). PHORESIS_HTTPS_PORT is then its port.
#PHORESIS_SHARED_CADDY_DIR=
# More names to answer on, comma separated (a VPN name). Set it with `phoresis.sh extra-host add NAME`,
# which also rewrites DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS and restarts what reads them.
#PHORESIS_EXTRA_HOSTNAMES=

# Where the data lives on this Mac (media, static files, Redis, Caddy certificates, logs)
#PHORESIS_DATA_DIR=/Users/<you>/Library/Application Support/Phoresis

# Media on two disks. Set by `phoresis.sh archive-disk "/Volumes/<disk>/Phoresis/media"`.
#PHORESIS_MEDIA_ARCHIVE_ROOT=
# Room gels may take on this Mac before the oldest originals move to the archive disk
#PHORESIS_MEDIA_HOT_QUOTA_GB=50
# Free space to keep on this Mac's disk, and on the archive disk
#PHORESIS_MEDIA_MIN_FREE_GB=20
#PHORESIS_MEDIA_ARCHIVE_MIN_FREE_GB=5
# Originals younger than this never move
#PHORESIS_MEDIA_ARCHIVE_MIN_AGE_DAYS=30

# Sign-in. Two-factor is required for: off | staff (staff and superusers) | all. The installer writes staff.
#PHORESIS_REQUIRE_2FA=staff
# Wrong passwords before an account is paused from that address, and for how long
#PHORESIS_LOGIN_FAILURE_LIMIT=5
#PHORESIS_LOGIN_COOLOFF_MINUTES=15

# Backups (02:30 every night). Default: next to the media archive, else in the data folder.
#PHORESIS_BACKUP_DIR=
#PHORESIS_BACKUP_KEEP=14

# Nightly update after the backup: off | release (latest vX.Y.Z tag) | branch (git pull)
#PHORESIS_AUTO_UPDATE=off

# Processes. Default: one gunicorn worker per performance core, half as many Celery children.
#GUNICORN_WORKERS=
#PHORESIS_WORKER_CONCURRENCY=
