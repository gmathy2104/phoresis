# syntax=docker/dockerfile:1.7
###############################################################################
# Phoresis worker container — Celery worker (queues: default, heavy)
# and Celery beat (scheduler), CPU/CUDA variants.
###############################################################################

ARG TORCH_VARIANT=cpu
ARG PYTHON_VERSION=3.12

# ============================================================================
# Stage A: Python deps (CPU). Identical pattern to Dockerfile.web's python-cpu.
# ============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS python-cpu
WORKDIR /app
# UV_PROJECT_ENVIRONMENT: see Dockerfile.web's python-cpu stage for why this
# is required (uv sync ignores VIRTUAL_ENV; without this it installs into
# /app/.venv instead of /opt/venv).
# UV_HTTP_TIMEOUT 300 s -- pypi.nvidia.com's CDN sometimes hangs on big
# wheels (nvidia-nvshmem-cu12, nvidia-cudnn-cu12 ~600 MB).
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv UV_HTTP_TIMEOUT=300

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev libjpeg-dev zlib1g-dev libtiff-dev \
        libfreetype6-dev liblcms2-dev libwebp-dev libopenjp2-7-dev \
        libgl1 libglib2.0-0 curl ca-certificates

RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/venv && \
    uv sync --no-dev --no-install-project --frozen && \
    /opt/venv/bin/python -c "import django, celery; print('django', django.__version__, '/ celery', celery.__version__, 'OK')"

# ============================================================================
# Stage B: Python deps (CUDA). Same as Dockerfile.web's python-cuda.
# CUDA 12.8 + cu128 PyTorch wheel for Blackwell (sm_120, RTX 50-series) support.
# Ubuntu 24.04 ships Python 3.12 natively — no deadsnakes PPA required.
# ============================================================================
FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04 AS python-cuda
WORKDIR /app
# UV_PROJECT_ENVIRONMENT + UV_HTTP_TIMEOUT: see Dockerfile.web's python-cuda
# stage for the rationale (NVIDIA CDN slowness on cu128 sub-deps).
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv UV_HTTP_TIMEOUT=300 DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
        build-essential libpq-dev libjpeg-dev zlib1g-dev libtiff-dev \
        libfreetype6-dev liblcms2-dev libwebp-dev libopenjp2-7-dev \
        libgl1 libglib2.0-0 \
        curl ca-certificates \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
# Same two-step ordering as Dockerfile.web's python-cuda — see comment there.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python 3.12 /opt/venv && \
    uv sync --no-dev --no-install-project --frozen && \
    uv pip install --python /opt/venv/bin/python \
        --reinstall-package torch --reinstall-package torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        torch torchvision && \
    /opt/venv/bin/python -c "import django, celery, torch; print('django', django.__version__, '/ celery', celery.__version__, '/ torch', torch.__version__)"

# ============================================================================
# Stage selector + runtime
# ============================================================================
FROM python-${TORCH_VARIANT} AS runtime
ARG TORCH_VARIANT=cpu

ENV DJANGO_SETTINGS_MODULE=phoresis.settings.prod \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH \
    PHORESIS_IMAGE_VARIANT=${TORCH_VARIANT} \
    PYTHONPATH=/app/src \
    SKIP_COLLECTSTATIC=1 \
    SKIP_SEEDS=1
# PYTHONPATH=/app/src so `celery -A phoresis_core.celery_app` resolves the
# package without going through manage.py. See Dockerfile.web for the full
# rationale.

# Ubuntu 24.04 (CUDA stage base) ships with a default 'ubuntu' user at UID 1000.
# Remove it first; on Debian slim-bookworm (CPU stage) the userdel is a no-op.
RUN (userdel -r ubuntu 2>/dev/null || true) && \
    useradd --create-home --shell /bin/bash --uid 1000 phoresis
WORKDIR /app

COPY --chown=phoresis:phoresis manage.py ./
COPY --chown=phoresis:phoresis src/ ./src/
COPY --chown=phoresis:phoresis docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# `sed -i 's/\r$//'` strips Windows CRLF line endings (see Dockerfile.web for
# the full explanation). Required so the shebang resolves correctly.
RUN mkdir -p /srv/media && \
    chown -R phoresis:phoresis /srv/media && \
    sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

ENV MEDIA_ROOT=/srv/media

USER phoresis

# Celery worker doesn't have a meaningful HTTP healthcheck — use `celery inspect ping` via shell.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD celery -A phoresis_core.celery_app inspect ping --timeout 3 || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["celery", "-A", "phoresis_core.celery_app", "worker", "--loglevel=info", "-Q", "default,heavy", "--concurrency=2"]
