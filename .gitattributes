*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt   filter=lfs diff=lfs merge=lfs -text

# Shell scripts MUST use LF line endings — Linux containers reject CRLF
# shebangs ("/bin/sh\r: no such file or directory" on Windows clones with
# core.autocrlf=true).
*.sh                text eol=lf
docker/entrypoint.sh text eol=lf
