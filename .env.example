# Django
DJANGO_SETTINGS_MODULE=phoresis.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,phoresis

# Database (native Postgres on host)
DB_NAME=phoresis
DB_USER=phoresis
DB_PASSWORD=phoresis
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Storage paths (host) ---
# Where uploaded gel images / thumbnails / exports live on the Windows host.
# Defaults to %USERPROFILE%\Phoresis-Data\media when set by install.ps1.
# Power users: override to put media on a different drive (e.g., D:/Phoresis-Data/media).
PHORESIS_MEDIA_DIR=

# Redis (Celery broker + cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_CELERY=0
REDIS_DB_CACHE=1

# Initial users (seeded by create_initial_users in Phase 6)
ADMIN_EMAIL=admin@phoresis.local
ADMIN_PASSWORD=change-me
PRIMARY_USER_EMAIL=lab@phoresis.local
PRIMARY_USER_PASSWORD=change-me
PRIMARY_USER_FULL_NAME=Lab User
